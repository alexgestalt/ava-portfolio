{
  "name": "AI Receptionist – Lead Qualification & Booking (demo)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-bot",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "616bc1e4-5e9b-4dd2-98d3-0fe33a185351",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "2184172d-99de-4aba-b6d0-87be0e0f6728"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are Ava, the friendly virtual receptionist for {{BUSINESS_NAME}}.\nGoal: qualify the visitor as a lead and book an appointment, in as few messages as possible.\nCollect: full name, need (service), urgency (High / Medium / Low), contact (mobile or email), preferred slot.\nRules:\n- Ask ONE question at a time. Be warm, short (max 2 sentences), plain language.\n- If the visitor gives several details at once, capture them all and skip those questions.\n- Answer FAQs (hours, pricing ranges, insurance, location) ONLY from the business info below, then return to the next missing field.\n- Never invent prices, availability or medical advice. If unsure, offer a callback from staff.\n- Offer slots only from AVAILABLE_SLOTS. Confirm a summary before booking.\n- Pain, swelling, bleeding or 'today/asap' = High urgency.\nBusiness info: {{BUSINESS_FAQ}}\nAVAILABLE_SLOTS: {{ $json.body.availableSlots || 'Tomorrow 9:30 AM, Tomorrow 1:00 PM, Fri 2:00 PM' }}\nAlways respond in the structured JSON format."
        }
      },
      "id": "f6643315-9076-419c-8d8a-3daacca73aa5",
      "name": "AI Receptionist Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "84067ff0-a945-4f8b-aa7c-f46eaf9ab767",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        140,
        540
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "OpenAI account (client's own key)"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Chat Webhook').item.json.body.sessionId }}",
        "contextWindowLength": 12
      },
      "id": "d6aa9466-bcdc-4053-bf03-6dab453c3b86",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        300,
        540
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"reply\": \"Thanks Jamie! What's the best mobile number for your confirmation?\",\n  \"lead\": {\n    \"name\": \"Jamie Rivera\",\n    \"need\": \"Chipped / broken tooth\",\n    \"urgency\": \"High\",\n    \"contact\": \"+15550142288\",\n    \"contact_type\": \"phone\",\n    \"slot\": \"Tomorrow 9:30 AM\"\n  },\n  \"lead_complete\": false,\n  \"booking_confirmed\": false,\n  \"handoff_to_human\": false\n}"
      },
      "id": "a7d89e4c-e1b8-41e8-9663-e4326c2547fa",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        460,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise the agent output and compute a simple lead score\nconst out = $input.first().json.output || {};\nconst lead = out.lead || {};\nconst body = $('Chat Webhook').first().json.body || {};\nlet score = 0;\nif (lead.need) score += 20;\nif (lead.name) score += 15;\nif (lead.contact) score += 20;\nif (lead.slot) score += 20;\nscore += ({ High: 25, Medium: 15, Low: 8 })[lead.urgency] || 0;\nreturn [{ json: {\n  sessionId: body.sessionId,\n  reply: out.reply,\n  booking_confirmed: !!out.booking_confirmed,\n  handoff_to_human: !!out.handoff_to_human,\n  ...lead,\n  lead_score: score,\n  source: body.source || 'website-chat',\n  captured_at: new Date().toISOString(),\n}}];"
      },
      "id": "411b6dc0-d0fc-4c20-b8e3-f69421857cfd",
      "name": "Normalize & Score Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "60d0ccea-57da-43f6-a440-7cab81bb3c94",
              "leftValue": "={{ $json.booking_confirmed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cb54755b-a86e-494f-a4e1-08aa72d08d1a",
      "name": "Booked?",

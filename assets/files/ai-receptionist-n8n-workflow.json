          "__rl": true,
          "value": "REPLACE_WITH_CALENDAR_ID",
          "mode": "id"
        },
        "start": "={{ $json.slot_start_iso || $now.plus(1,'day').set({hour:9,minute:30}).toISO() }}",
        "end": "={{ $json.slot_end_iso || $now.plus(1,'day').set({hour:10,minute:0}).toISO() }}",
        "additionalFields": {
          "summary": "={{ $json.need }} – {{ $json.name }} ({{ $json.urgency }})",
          "description": "=Booked by AI receptionist. Contact: {{ $json.contact }}. Lead score: {{ $json.lead_score }}"
        }
      },
